        <mxCell id="card-commit" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#34d399&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;I want to change… → commit in&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• A calculation rule → backend/src/carcost/domain/ (no I/O allowed).&lt;br&gt;• A use case or a port → backend/src/carcost/application/.&lt;br&gt;• A route, SQL or the price adapter → backend/src/carcost/infrastructure/.&lt;br&gt;• The schema → a new backend/migrations/000N_*.sql, never edit an old one.&lt;br&gt;• A BOM or a price → tools/, then regenerate seeds/: never edit seeds/ by hand.&lt;br&gt;• The screen → frontend/src/; the API contract → frontend/src/api/types.ts.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="540" y="980" width="560" height="360" as="geometry" />
        </mxCell>
        <mxCell id="card-guards" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fbbf24&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;What CI refuses&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;• domain/ or application/ importing infrastructure/ or an I/O library (test_layer_dependencies.py).&lt;br&gt;• seeds/ differing from what tools/ regenerate (bom_generator --check, valhalla_import --check).&lt;br&gt;• A migration that lets one of the 26 forbidden writes through (migrations/checks/contraintes.sql).&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="980" width="350" height="360" as="geometry" />
        </mxCell>
        <mxCell id="card-gaps" value="&lt;span style=&quot;font-variant-ligatures:none&quot;&gt;&lt;font color=&quot;#fb7185&quot;&gt;●&lt;/font&gt;&amp;nbsp;&lt;b&gt;&lt;font color=&quot;#f8fafc&quot; style=&quot;font-size:13px&quot;&gt;Gaps between docs and code&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;line-height:1.6&quot;&gt;[G3] architecture.md §2 says the archtest guards domain; it also guards application.&lt;br&gt;[G4] tools/price_history.py and price-api/data/ are absent from AGENTS.md and the README.&lt;/div&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#0b1222;strokeColor=#1e293b;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;spacingRight=16;fontFamily=JetBrains Mono,Noto Sans Mono,DejaVu Sans Mono,monospace;fontSize=11;fontColor=#e2e8f0;" vertex="1" parent="1">
          <mxGeometry x="1510" y="980" width="310" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
